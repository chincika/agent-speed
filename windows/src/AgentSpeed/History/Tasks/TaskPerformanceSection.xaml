<UserControl x:Class="AgentSpeed.History.Tasks.TaskPerformanceSection"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AgentSpeed.Controls"
             xmlns:tasks="clr-namespace:AgentSpeed.History.Tasks"
             xmlns:layout="clr-namespace:AgentSpeed.Presentation.History.Tasks;assembly=AgentSpeed.Presentation"
             Focusable="False" IsTabStop="False"
             tasks:TaskAppearance.Dark="{Binding Dark}"
             tasks:TaskAppearance.HighContrast="{Binding HighContrast}"
             tasks:TaskAppearance.ReduceMotion="{Binding ReduceMotion}"
             tasks:TaskAppearance.Generation="{Binding AppearanceGeneration}"
             AutomationProperties.Name="{Binding Title}">
    <!-- Task performance (DESIGN 4b, 3c; DESIGN 12, Usage History: task performance): its data context is the window's
         TaskPerformanceViewModel; the window puts it in a card between Effort and speed and the daily table. A group named
         history.tasks.title whose title is a heading. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AgentSpeed;component/History/Tasks/TaskResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="SourceOptionTemplate" DataType="{x:Type tasks:TaskSourceOption}">
                <DockPanel>
                    <tasks:TaskSourceDots DockPanel.Dock="Left" Sources="{Binding Sources}" DotSize="{x:Static layout:TaskPerformanceLayout.PickerDot}"
                                          VerticalAlignment="Center" Margin="0,1,6,0" />
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
            </DataTemplate>

            <!-- A picker's choice: a soft chip under the pointer or the keyboard, an accent pill beside the current one. -->
            <Style x:Key="PickerItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="12,0,12,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Grid>
                                <Border x:Name="Chip" CornerRadius="4" Background="{TemplateBinding Background}" />
                                <Border x:Name="Pill" Width="3" Height="12" CornerRadius="1.5" HorizontalAlignment="Left" Margin="2,0,0,0"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The chip a picker draws: a small bordered pop-up button (DESIGN 12, Header). -->
            <Style x:Key="PickerChip" TargetType="ToggleButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="ClickMode" Value="Press" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chip" CornerRadius="4" BorderThickness="1" SnapsToDevicePixels="True"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A pair picker: a 7 DIP source dot and the name, a chevron, and a Fluent flyout list. -->
            <Style x:Key="Picker" TargetType="ComboBox">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Height" Value="24" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MaxWidth" Value="200" />
                <Setter Property="Padding" Value="9,0,7,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="MaxDropDownHeight" Value="320" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource RoundedFocusVisual}" />
                <Setter Property="ItemTemplate" Value="{StaticResource SourceOptionTemplate}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource PickerItem}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Style="{StaticResource PickerChip}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                <DockPanel Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{DynamicResource AppSymbolFontFamily}" FontSize="8"
                                               Margin="7,1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" />
                                </DockPanel>
                                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                       HorizontalOffset="-12" VerticalOffset="-8"
                                       IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Margin="12" Padding="4" CornerRadius="8" BorderThickness="1"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}"
                                            TextElement.FontFamily="{DynamicResource AppFontFamily}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.2" />
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" Focusable="False"
                                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Header: the title and ⓘ; trailing, the two pickers with vs between them, or the one source with records. -->
        <Grid x:Name="Header">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Title}" FontSize="{x:Static layout:TaskPerformanceLayout.TitleSize}" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level2" />
            <Button x:Name="InfoButton" Grid.Column="1" Style="{DynamicResource SubtleButton}" MinWidth="24" Width="24" Height="24" Padding="0"
                    Margin="4,1,0,0" VerticalAlignment="Center" Click="OnInfo"
                    ToolTip="{Binding InfoLabel}" AutomationProperties.Name="{Binding InfoLabel}" AutomationProperties.HelpText="{Binding Info}">
                <TextBlock Text="&#xE946;" FontFamily="{DynamicResource AppSymbolFontFamily}" FontSize="13" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Button>
            <Grid x:Name="Trailing" Grid.Column="2" HorizontalAlignment="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                <Grid x:Name="Pickers" Visibility="{Binding ShowsPickers, Converter={StaticResource Visible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PickerAColumn" Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="PickerBColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PickerA" Style="{StaticResource Picker}"
                              AutomationProperties.Name="{Binding PickA}" AutomationProperties.HelpText="{Binding PickAHelp}" />
                    <TextBlock Grid.Column="1" Text="{Binding Versus}" FontSize="{x:Static layout:TaskPerformanceLayout.VersusSize}" Margin="7,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ComboBox x:Name="PickerB" Grid.Column="2" Style="{StaticResource Picker}"
                              AutomationProperties.Name="{Binding PickB}" AutomationProperties.HelpText="{Binding PickBHelp}" />
                </Grid>
                <TextBlock x:Name="OnlyOneText" Text="{Binding OnlyOne}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Right"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding ShowsOnlyOne, Converter={StaticResource Visible}}" />
            </Grid>
        </Grid>

        <!-- What the ⓘ opens: history.tasks.info and every metric's full name with its hint; Escape or a click elsewhere closes it. -->
        <Popup x:Name="InfoFlyout" PlacementTarget="{Binding ElementName=InfoButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" HorizontalOffset="-12" VerticalOffset="-8" Closed="OnInfoClosed" KeyDown="OnInfoKeyDown">
            <Border Margin="12" Width="{x:Static layout:TaskPerformanceLayout.InfoWidth}" Padding="16,14,16,12" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    TextElement.FontFamily="{DynamicResource AppFontFamily}" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.2" />
                </Border.Effect>
                <ScrollViewer x:Name="InfoScroller" MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly" Focusable="True" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Title}">
                    <StackPanel>
                        <TextBlock Text="{Binding Info}" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
                        <Rectangle Style="{DynamicResource Hairline}" Margin="0,12,0,10" />
                        <ItemsControl ItemsSource="{Binding InfoTerms}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type layout:TaskInfoTerm}">
                                    <StackPanel Margin="0,0,0,9">
                                        <TextBlock Text="{Binding Term}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Hint}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <Grid x:Name="Body">
            <!-- Re-analysing: static placeholders in the track color where the side headers and rows will be. -->
            <StackPanel Visibility="{Binding ShowsAnalyzing, Converter={StaticResource Visible}}">
                <tasks:TaskPlaceholderView Layout="{Binding Width}" Margin="0,16,0,0" />
                <TextBlock x:Name="AnalyzingLine" Text="{Binding AnalyzingText}" FontSize="11.5" Margin="0,12,0,2" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <!-- No scored task in the range: the section stays, so the feature is discoverable. -->
            <StackPanel Visibility="{Binding ShowsEmpty, Converter={StaticResource Visible}}" Margin="12,22,12,10" HorizontalAlignment="Center">
                <controls:GaugeGlyph Width="30" Height="30" HorizontalAlignment="Center"
                                     TextElement.Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{Binding EmptyText}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding EmptyHint}" FontSize="11.5" LineHeight="17" Margin="0,5,0,0" MaxWidth="340" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Visibility="{Binding ShowsData, Converter={StaticResource Visible}}">
                <tasks:TaskPairView Margin="0,16,0,0" Visibility="{Binding ShowsButterfly, Converter={StaticResource Visible}}" />
                <tasks:TaskPairNarrowView Margin="0,12,0,0" Visibility="{Binding ShowsPairCards, Converter={StaticResource Visible}}" />
                <tasks:TaskSingleView Margin="0,16,0,0" Visibility="{Binding ShowsSingle, Converter={StaticResource Visible}}" />
                <tasks:TaskModelsView Visibility="{Binding ShowsModels, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding Footnote}" FontSize="{x:Static layout:TaskPerformanceLayout.FootnoteSize}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
