<UserControl x:Class="AgentSpeed.History.Tasks.TaskSideHeader"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tasks="clr-namespace:AgentSpeed.History.Tasks"
             xmlns:layout="clr-namespace:AgentSpeed.Presentation.History.Tasks;assembly=AgentSpeed.Presentation"
             Focusable="False" IsTabStop="False">
    <!-- A side header (DESIGN 12, Side headers): the source, its counts and chip, then the median (its caption beside it on one baseline) beside the distribution.
         The left side mirrors only its alignment, toward the centre; the distribution's axis still runs 0 → 100. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>

    <tasks:TaskAutomationBlock IsGroup="True" Background="Transparent" AutomationProperties.Name="{Binding Spoken}">
        <StackPanel x:Name="Stack" HorizontalAlignment="Left">
            <Grid x:Name="NameRow" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <tasks:TaskSourceDots x:Name="Dot" Sources="{Binding Sources}" DotSize="{x:Static layout:TaskPerformanceLayout.PickerDot}"
                                      VerticalAlignment="Center" Margin="0,1,0,0" />
                <TextBlock x:Name="NameText" Grid.Column="2" Text="{Binding Name}" FontSize="{x:Static layout:TaskPerformanceLayout.SideNameSize}"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="EmptyLine" Text="{Binding EmptyText}" FontSize="{x:Static layout:TaskPerformanceLayout.CountsSize}" Margin="0,3,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />

            <StackPanel x:Name="CountsRow" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,3,0,0"
                        Visibility="{Binding HasRecords, Converter={StaticResource Visible}}">
                <tasks:TaskFadeText Text="{Binding Counts}" FontSize="{x:Static layout:TaskPerformanceLayout.CountsSize}" VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <tasks:TaskSampleChip Text="{Binding LowSampleText}" ToolTip="{Binding LowSampleHint}" Margin="6,0,0,0"
                                      Visibility="{Binding LowSample, Converter={StaticResource Visible}}" />
            </StackPanel>

            <Grid x:Name="MedianRow" HorizontalAlignment="Left" Margin="0,6,0,0"
                  Visibility="{Binding HasRecords, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="MedianBlock" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <tasks:TaskFadeText x:Name="MedianText" Text="{Binding Median}" FontSize="{x:Static layout:TaskPerformanceLayout.MedianSize}"
                                        FontWeight="SemiBold" FontFamily="{DynamicResource AppDisplayFontFamily}" LineHeight="40"
                                        VerticalAlignment="Bottom" />
                    <TextBlock x:Name="CaptionText" Text="{Binding MedianCaption}" FontSize="{x:Static layout:TaskPerformanceLayout.CaptionSize}"
                               Margin="5,0,0,6" VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <tasks:TaskHistogramView x:Name="Distribution" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                         Histogram="{Binding Histogram}" Color="{Binding Color}"
                                         AutomationProperties.Name="{Binding Histogram.Spoken}"
                                         TickBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                         AxisBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                         BaselineBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
            </Grid>
        </StackPanel>
    </tasks:TaskAutomationBlock>
</UserControl>
