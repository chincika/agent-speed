<UserControl x:Class="AgentSpeed.History.Tasks.TaskPairView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tasks="clr-namespace:AgentSpeed.History.Tasks"
             xmlns:layout="clr-namespace:AgentSpeed.Presentation.History.Tasks;assembly=AgentSpeed.Presentation"
             Focusable="False" IsTabStop="False" tasks:TaskPairView.CenterWidth="{Binding CenterColumn}">
    <!-- Two sources side by side, wide and medium (DESIGN 12, Side headers and Comparison rows): the side headers either side
         of the centre column, a hairline, and five 36 DIP butterfly rows — value at the outer edge, a track filled from the
         centre outward, the metric in the centre. Every row is one element for screen readers. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AgentSpeed;component/History/Tasks/TaskResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="CompareRowTemplate" DataType="{x:Type tasks:TaskCompareRowView}">
                <tasks:TaskAutomationBlock Background="Transparent" MinHeight="{x:Static layout:TaskPerformanceLayout.RowHeight}"
                                           AutomationProperties.Name="{Binding Spoken}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Static tasks:TaskPairView.ValueColumn}" />
                            <ColumnDefinition Width="{x:Static tasks:TaskPairView.Gap}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{x:Static tasks:TaskPairView.Gap}" />
                            <ColumnDefinition Width="{Binding (tasks:TaskPairView.CenterWidth), RelativeSource={RelativeSource Self}}" />
                            <ColumnDefinition Width="{x:Static tasks:TaskPairView.Gap}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{x:Static tasks:TaskPairView.Gap}" />
                            <ColumnDefinition Width="{x:Static tasks:TaskPairView.ValueColumn}" />
                        </Grid.ColumnDefinitions>
                        <tasks:TaskFadeText Style="{StaticResource CompareValue}" Value="{Binding A}" TextAlignment="Right" />
                        <tasks:TaskCompareTrack Grid.Column="2" FromEnd="True" VerticalAlignment="Center"
                                                Height="{x:Static layout:TaskPerformanceLayout.TrackHeight}"
                                                Fraction="{Binding A.Fraction}" Color="{Binding ColorA}" />
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,5" Background="Transparent" ToolTip="{Binding Hint}">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource MetricName}" TextAlignment="Center" />
                            <TextBlock Text="{Binding LowerBetterText}" Style="{StaticResource LowerBetter}" TextAlignment="Center"
                                       Visibility="{Binding LowerIsBetter, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <tasks:TaskCompareTrack Grid.Column="6" VerticalAlignment="Center" Height="{x:Static layout:TaskPerformanceLayout.TrackHeight}"
                                                Fraction="{Binding B.Fraction}" Color="{Binding ColorB}" />
                        <tasks:TaskFadeText Grid.Column="8" Style="{StaticResource CompareValue}" Value="{Binding B}" TextAlignment="Left" />
                    </Grid>
                </tasks:TaskAutomationBlock>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{x:Static tasks:TaskPairView.ValueColumn}" />
            <ColumnDefinition Width="{x:Static tasks:TaskPairView.Gap}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{x:Static tasks:TaskPairView.Gap}" />
            <ColumnDefinition Width="{Binding (tasks:TaskPairView.CenterWidth), RelativeSource={RelativeSource Self}}" />
            <ColumnDefinition Width="{x:Static tasks:TaskPairView.Gap}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{x:Static tasks:TaskPairView.Gap}" />
            <ColumnDefinition Width="{x:Static tasks:TaskPairView.ValueColumn}" />
        </Grid.ColumnDefinitions>

        <tasks:TaskSideHeader Grid.ColumnSpan="3" DataContext="{Binding SideA}" Mirrored="True" HorizontalAlignment="Right" Margin="0,0,0,14"
                              HistogramWidth="{Binding DataContext.HistogramWidth, RelativeSource={RelativeSource AncestorType=tasks:TaskPairView}}" />
        <tasks:TaskSideHeader Grid.Column="6" Grid.ColumnSpan="3" DataContext="{Binding SideB}" HorizontalAlignment="Left" Margin="0,0,0,14"
                              HistogramWidth="{Binding DataContext.HistogramWidth, RelativeSource={RelativeSource AncestorType=tasks:TaskPairView}}" />

        <Rectangle Grid.Row="1" Grid.ColumnSpan="9" Style="{DynamicResource Hairline}" Margin="0,0,0,6" />

        <ItemsControl Grid.Row="2" Grid.ColumnSpan="9" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource CompareRowTemplate}"
                      Focusable="False" />
    </Grid>
</UserControl>
