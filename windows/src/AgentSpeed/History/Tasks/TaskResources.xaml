<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AgentSpeed.Controls"
                    xmlns:tasks="clr-namespace:AgentSpeed.History.Tasks"
                    xmlns:layout="clr-namespace:AgentSpeed.Presentation.History.Tasks;assembly=AgentSpeed.Presentation">
    <!-- Shared by the task performance section's parts (DESIGN 12, Usage History: task performance). -->
    <BooleanToVisibilityConverter x:Key="Visible" />
    <controls:InverseBoolToVisibilityConverter x:Key="Hidden" />

    <!-- A metric's full name: 12 DIP medium, the label color at 85 %, up to two lines; its hint is the tooltip. -->
    <Style x:Key="MetricName" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static layout:TaskPerformanceLayout.MetricSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="LineHeight" Value="15" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="MaxHeight" Value="30" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding (tasks:TaskAppearance.HighContrast), RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- history.tasks.lowerBetter under the lower-is-better metrics: 10 DIP, tertiary. -->
    <Style x:Key="LowerBetter" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static layout:TaskPerformanceLayout.LowerBetterSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A comparison value: 13 DIP tabular, its emphasis from the value itself. -->
    <Style x:Key="CompareValue" TargetType="tasks:TaskFadeText">
        <Setter Property="FontSize" Value="{x:Static layout:TaskPerformanceLayout.ValueSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
</ResourceDictionary>
