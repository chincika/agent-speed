<UserControl x:Class="AgentSpeed.History.Tasks.TaskModelsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AgentSpeed.Controls"
             xmlns:history="clr-namespace:AgentSpeed.History"
             xmlns:tasks="clr-namespace:AgentSpeed.History.Tasks"
             xmlns:layout="clr-namespace:AgentSpeed.Presentation.History.Tasks;assembly=AgentSpeed.Presentation"
             Focusable="False" IsTabStop="False">
    <!-- By model (DESIGN 12, By model): a native table in the daily table's style — 30 DIP rows, alternating tint, hover
         highlight, sortable headers that keep room for the sort glyph, copy row as text — and, narrow, a list of rows. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AgentSpeed;component/History/Tasks/TaskResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The empty room to the right of the last column. -->
            <Style x:Key="PaddingHeader" TargetType="GridViewColumnHeader">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Headers, a hairline and the rows; no scroller of its own, so the page scrolls over it and nothing scrolls sideways. -->
            <Style x:Key="TableStyle" TargetType="ListView">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="AlternationCount" Value="2" />
                <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListView">
                            <StackPanel>
                                <GridViewHeaderRowPresenter x:Name="HeaderRow" AllowsColumnReorder="False"
                                                            Columns="{Binding View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ColumnHeaderContainerStyle="{StaticResource PaddingHeader}"
                                                            KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained" />
                                <Rectangle Height="1" Margin="0,0,0,2" SnapsToDevicePixels="True" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                <ItemsPresenter KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained" />
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <history:SpringStackPanel ReduceMotion="{Binding (tasks:TaskAppearance.ReduceMotion), RelativeSource={RelativeSource Self}}" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A sortable header (the window's HeaderButton): secondary text, primary when sorted or hovered, the cells' padding. -->
            <Style x:Key="HeaderStyle" TargetType="GridViewColumnHeader">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="6,6,6,6" />
                <Setter Property="VerticalContentAlignment" Value="Bottom" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="IsTabStop" Value="True" />
                <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource RoundedFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Grid>
                                <Border x:Name="Chip" CornerRadius="4" Background="{TemplateBinding Background}" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="False"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A row: alternating tint, the selection and hover chip; one element named with every column. -->
            <Style x:Key="TableRow" TargetType="ListViewItem">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Height" Value="{x:Static layout:TaskPerformanceLayout.ModelRowHeight}" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource RoundedFocusVisual}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="Chip" CornerRadius="4" Background="{TemplateBinding Background}">
                                <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A numeric cell: 12.5 DIP tabular, right-aligned, in secondary for a small sample. -->
            <Style x:Key="NumberCell" TargetType="tasks:TaskFadeText">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Secondary" Value="{Binding LowSample}" />
            </Style>

            <!-- The strip keeps its room without a scored task, so the medians stay aligned. -->
            <Style x:Key="Strip" TargetType="tasks:TaskIqrStrip">
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TickBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Strip" Value="{Binding Strip}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasStrip}" Value="False">
                        <Setter Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The model id: 12.5 DIP medium, middle truncation; secondary for a small sample; an unknown model in secondary italic. -->
            <Style x:Key="ModelId" TargetType="history:MiddleTrimmedText">
                <Setter Property="FontSize" Value="{x:Static layout:TaskPerformanceLayout.ModelIdSize}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Text" Value="{Binding Name}" />
                <Setter Property="ToolTip" Value="{Binding Name}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LowSample}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                        <Setter Property="FontStyle" Value="Italic" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The narrow list's id: semibold, medium for a small sample. -->
            <Style x:Key="ListModelId" TargetType="history:MiddleTrimmedText" BasedOn="{StaticResource ModelId}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LowSample}" Value="True">
                        <Setter Property="FontWeight" Value="Medium" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The model cell: overlapping source dots, the id, and the small-sample chip right after it. -->
            <DataTemplate x:Key="ModelCell" DataType="{x:Type tasks:TaskModelRowView}">
                <tasks:TaskAutomationBlock Background="Transparent" ToolTip="{Binding SourcesTooltip}" AutomationProperties.Name="{Binding ModelSpoken}">
                    <DockPanel>
                        <tasks:TaskSourceDots DockPanel.Dock="Left" Sources="{Binding Sources}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <controls:ShrinkFirstPanel VerticalAlignment="Center">
                            <history:MiddleTrimmedText Style="{StaticResource ModelId}" />
                            <tasks:TaskSampleChip Text="{Binding LowSampleText}" ToolTip="{Binding LowSampleHint}" Margin="7,0,0,0"
                                                  Visibility="{Binding LowSample, Converter={StaticResource Visible}}" />
                        </controls:ShrinkFirstPanel>
                    </DockPanel>
                </tasks:TaskAutomationBlock>
            </DataTemplate>

            <DataTemplate x:Key="TasksCell" DataType="{x:Type tasks:TaskModelRowView}">
                <tasks:TaskFadeText Style="{StaticResource NumberCell}" Text="{Binding Tasks}" />
            </DataTemplate>

            <DataTemplate x:Key="ScoredCell" DataType="{x:Type tasks:TaskModelRowView}">
                <tasks:TaskFadeText Style="{StaticResource NumberCell}" Text="{Binding Scored}" />
            </DataTemplate>

            <DataTemplate x:Key="MergedCell" DataType="{x:Type tasks:TaskModelRowView}">
                <tasks:TaskFadeText Style="{StaticResource NumberCell}" Text="{Binding ScoredOfTasks}" />
            </DataTemplate>

            <DataTemplate x:Key="MedianCell" DataType="{x:Type tasks:TaskModelRowView}">
                <tasks:TaskAutomationBlock HorizontalAlignment="Right" AutomationProperties.Name="{Binding MedianSpoken}">
                    <StackPanel Orientation="Horizontal">
                        <tasks:TaskFadeText Style="{StaticResource NumberCell}" Text="{Binding Median}" />
                        <tasks:TaskIqrStrip Style="{StaticResource Strip}" />
                    </StackPanel>
                </tasks:TaskAutomationBlock>
            </DataTemplate>

            <DataTemplate x:Key="SuccessCell" DataType="{x:Type tasks:TaskModelRowView}">
                <tasks:TaskFadeText Style="{StaticResource NumberCell}" Value="{Binding Success}" />
            </DataTemplate>

            <DataTemplate x:Key="StallCell" DataType="{x:Type tasks:TaskModelRowView}">
                <tasks:TaskFadeText Style="{StaticResource NumberCell}" Value="{Binding Stall}" />
            </DataTemplate>

            <DataTemplate x:Key="FixFailCell" DataType="{x:Type tasks:TaskModelRowView}">
                <tasks:TaskFadeText Style="{StaticResource NumberCell}" Value="{Binding FixFail}" />
            </DataTemplate>

            <DataTemplate x:Key="AttemptsCell" DataType="{x:Type tasks:TaskModelRowView}">
                <tasks:TaskFadeText Style="{StaticResource NumberCell}" Value="{Binding Attempts}" />
            </DataTemplate>

            <DataTemplate x:Key="FirstPassCell" DataType="{x:Type tasks:TaskModelRowView}">
                <tasks:TaskFadeText Style="{StaticResource NumberCell}" Value="{Binding FirstPass}" />
            </DataTemplate>

            <!-- Narrow: a keyboard list of rows (no scroller of its own). -->
            <Style x:Key="ListStyle" TargetType="ListBox">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
                <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <history:SpringStackPanel ReduceMotion="{Binding (tasks:TaskAppearance.ReduceMotion), RelativeSource={RelativeSource Self}}" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A list row: a hairline under it; hover, focus and selection show a soft chip. One element for screen readers. -->
            <Style x:Key="ListItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="4,9,4,9" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource RoundedFocusVisual}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Background="Transparent">
                                <Border x:Name="Chip" CornerRadius="4" Margin="0,1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Line 1: dots, id and chip, then the median and its strip; line 2 the rates; line 3 counts, attempts and first pass. -->
            <DataTemplate x:Key="ListRow" DataType="{x:Type tasks:TaskModelRowView}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <tasks:TaskFadeText x:Name="MedianText" Text="{Binding Median}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                Secondary="{Binding LowSample}" />
                            <tasks:TaskIqrStrip Style="{StaticResource Strip}" />
                        </StackPanel>
                        <tasks:TaskSourceDots DockPanel.Dock="Left" Sources="{Binding Sources}" VerticalAlignment="Center" Margin="0,0,7,0"
                                              ToolTip="{Binding SourcesTooltip}" />
                        <controls:ShrinkFirstPanel VerticalAlignment="Center">
                            <history:MiddleTrimmedText Style="{StaticResource ListModelId}" />
                            <tasks:TaskSampleChip Text="{Binding LowSampleText}" ToolTip="{Binding LowSampleHint}" Margin="7,0,0,0"
                                                  Visibility="{Binding LowSample, Converter={StaticResource Visible}}" />
                        </controls:ShrinkFirstPanel>
                    </DockPanel>
                    <tasks:TaskFadeText Text="{Binding Line2}" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,3,0,0"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <tasks:TaskFadeText Text="{Binding Line3}" FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding LowSample}" Value="True">
                        <Setter TargetName="MedianText" Property="FontWeight" Value="Medium" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding ByModel}" FontSize="{x:Static layout:TaskPerformanceLayout.ByModelSize}" FontWeight="SemiBold"
                   Margin="{x:Static tasks:TaskModelsView.TitleMargin}" AutomationProperties.HeadingLevel="Level3" />

        <ListView x:Name="Table" Style="{StaticResource TableStyle}" ItemContainerStyle="{StaticResource TableRow}" ItemsSource="{Binding Models}"
                  AutomationProperties.Name="{Binding ByModel}" Visibility="{Binding ShowsTable, Converter={StaticResource Visible}}">
            <ListView.View>
                <GridView x:Name="TableView" AllowsColumnReorder="False" />
            </ListView.View>
        </ListView>

        <ListBox x:Name="List" Style="{StaticResource ListStyle}" ItemContainerStyle="{StaticResource ListItem}" ItemTemplate="{StaticResource ListRow}"
                 ItemsSource="{Binding Models}" AutomationProperties.Name="{Binding ByModel}"
                 Visibility="{Binding ShowsList, Converter={StaticResource Visible}}" />
    </StackPanel>
</UserControl>
