<UserControl x:Class="AgentSpeed.History.Tasks.TaskPairNarrowView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tasks="clr-namespace:AgentSpeed.History.Tasks"
             xmlns:layout="clr-namespace:AgentSpeed.Presentation.History.Tasks;assembly=AgentSpeed.Presentation"
             Focusable="False" IsTabStop="False">
    <!-- Two sources side by side, narrow (DESIGN 12, Widths): two equal side cards, then a three-column table under a header
         row of the two source names — the metric (wrapping, with lowerBetter under it) and the two values right-aligned in
         72 DIP columns, the better one semibold. Every row is one element for screen readers. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AgentSpeed;component/History/Tasks/TaskResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A source name over its value column: dot and name, right-aligned, wrapping. -->
            <DataTemplate x:Key="ColumnHeadTemplate" DataType="{x:Type tasks:TaskSideView}">
                <DockPanel HorizontalAlignment="Right">
                    <tasks:TaskSourceDots DockPanel.Dock="Left" Sources="{Binding Sources}" DotSize="6" VerticalAlignment="Top" Margin="0,4,4,0" />
                    <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right"
                               LineHeight="13" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
            </DataTemplate>

            <DataTemplate x:Key="CompareRowTemplate" DataType="{x:Type tasks:TaskCompareRowView}">
                <tasks:TaskAutomationBlock Background="Transparent" BorderThickness="0,0,0,1"
                                           BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                           AutomationProperties.Name="{Binding Spoken}">
                    <Grid Margin="0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{x:Static tasks:TaskPairNarrowView.ValueColumn}" />
                            <ColumnDefinition Width="{x:Static tasks:TaskPairNarrowView.ValueColumn}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Top" Background="Transparent" ToolTip="{Binding Hint}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextWrapping="Wrap" LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                            <TextBlock Text="{Binding LowerBetterText}" Style="{StaticResource LowerBetter}" Margin="0,1,0,0"
                                       Visibility="{Binding LowerIsBetter, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <tasks:TaskFadeText Grid.Column="1" Value="{Binding A}" FontSize="12.5" TextAlignment="Right" VerticalAlignment="Top"
                                            LineHeight="16" />
                        <tasks:TaskFadeText Grid.Column="2" Value="{Binding B}" FontSize="12.5" TextAlignment="Right" VerticalAlignment="Top"
                                            LineHeight="16" />
                    </Grid>
                </tasks:TaskAutomationBlock>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <tasks:TaskSideCard DataContext="{Binding SideA}" />
            <tasks:TaskSideCard Grid.Column="2" DataContext="{Binding SideB}" />
        </Grid>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{x:Static tasks:TaskPairNarrowView.ValueColumn}" />
                <ColumnDefinition Width="{x:Static tasks:TaskPairNarrowView.ValueColumn}" />
            </Grid.ColumnDefinitions>
            <ContentPresenter Grid.Column="1" Content="{Binding SideA}" ContentTemplate="{StaticResource ColumnHeadTemplate}" VerticalAlignment="Bottom"
                              Margin="4,0,0,6" />
            <ContentPresenter Grid.Column="2" Content="{Binding SideB}" ContentTemplate="{StaticResource ColumnHeadTemplate}" VerticalAlignment="Bottom"
                              Margin="4,0,0,6" />
        </Grid>
        <Rectangle Style="{DynamicResource Hairline}" />
        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource CompareRowTemplate}" Focusable="False" />
    </StackPanel>
</UserControl>
