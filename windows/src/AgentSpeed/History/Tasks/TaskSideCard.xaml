<UserControl x:Class="AgentSpeed.History.Tasks.TaskSideCard"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tasks="clr-namespace:AgentSpeed.History.Tasks"
             xmlns:layout="clr-namespace:AgentSpeed.Presentation.History.Tasks;assembly=AgentSpeed.Presentation"
             Focusable="False" IsTabStop="False">
    <!-- The narrow layout's side card (DESIGN 12, Widths): radius 10, the label color at 5 %, padding 10; dot and name, the
         median at 24 with its caption beside it, the counts wrapping, and the distribution across the card. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>

    <tasks:TaskAutomationBlock IsGroup="True" AutomationProperties.Name="{Binding Spoken}">
        <Grid>
            <Border x:Name="Fill" CornerRadius="{x:Static tasks:TaskSideCard.CardRadius}" Background="{DynamicResource TextFillColorPrimaryBrush}"
                    Opacity="0.05" />
            <Border x:Name="Outline" CornerRadius="{x:Static tasks:TaskSideCard.CardRadius}" BorderThickness="1" Visibility="Collapsed"
                    BorderBrush="{DynamicResource TextFillColorPrimaryBrush}" />
            <StackPanel Margin="{x:Static tasks:TaskSideCard.CardPadding}">
                <DockPanel>
                    <tasks:TaskSourceDots DockPanel.Dock="Left" Sources="{Binding Sources}" DotSize="{x:Static layout:TaskPerformanceLayout.PickerDot}"
                                          VerticalAlignment="Center" Margin="0,1,7,0" />
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Text="{Binding EmptyText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="15"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />

                <StackPanel Visibility="{Binding HasRecords, Converter={StaticResource Visible}}">
                    <WrapPanel Margin="0,6,0,0">
                        <tasks:TaskFadeText x:Name="MedianText" Text="{Binding Median}" FontSize="{x:Static layout:TaskPerformanceLayout.NarrowMedianSize}"
                                            FontWeight="SemiBold" FontFamily="{DynamicResource AppDisplayFontFamily}" LineHeight="29"
                                            VerticalAlignment="Bottom" />
                        <TextBlock x:Name="CaptionText" Text="{Binding MedianCaption}" FontSize="{x:Static layout:TaskPerformanceLayout.CaptionSize}" Margin="5,0,0,4"
                                   VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,2,0,0">
                        <tasks:TaskFadeText Text="{Binding Counts}" FontSize="11" TextWrapping="Wrap" LineHeight="15" VerticalAlignment="Center"
                                            Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <tasks:TaskSampleChip Text="{Binding LowSampleText}" ToolTip="{Binding LowSampleHint}" Margin="0,1,0,1"
                                              Visibility="{Binding LowSample, Converter={StaticResource Visible}}" />
                    </WrapPanel>
                    <tasks:TaskHistogramView Margin="0,8,0,0" Histogram="{Binding Histogram}" Color="{Binding Color}"
                                             AutomationProperties.Name="{Binding Histogram.Spoken}"
                                             TickBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                             AxisBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                             BaselineBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </tasks:TaskAutomationBlock>
</UserControl>
