<UserControl x:Class="AgentSpeed.History.Tasks.TaskSingleView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tasks="clr-namespace:AgentSpeed.History.Tasks"
             xmlns:layout="clr-namespace:AgentSpeed.Presentation.History.Tasks;assembly=AgentSpeed.Presentation"
             Focusable="False" IsTabStop="False">
    <!-- One source (DESIGN 12, One source): its side header across the section, then one bar per metric — the label column,
         the bar and the value. Narrow: the header is the side card. Every row is one element for screen readers. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AgentSpeed;component/History/Tasks/TaskResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="SingleRowTemplate" DataType="{x:Type tasks:TaskSingleRowView}">
                <tasks:TaskAutomationBlock Background="Transparent" MinHeight="{x:Static layout:TaskPerformanceLayout.RowHeight}"
                                           AutomationProperties.Name="{Binding Spoken}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding (tasks:TaskSingleView.LabelWidth), RelativeSource={RelativeSource Self}}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="{x:Static tasks:TaskPairView.ValueColumn}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,5,12,5" Background="Transparent" ToolTip="{Binding Hint}">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource MetricName}" />
                            <TextBlock Text="{Binding LowerBetterText}" Style="{StaticResource LowerBetter}"
                                       Visibility="{Binding LowerIsBetter, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <tasks:TaskCompareTrack Grid.Column="1" VerticalAlignment="Center" Height="{x:Static layout:TaskPerformanceLayout.TrackHeight}"
                                                Fraction="{Binding Value.Fraction}" Color="{Binding Color}" />
                        <tasks:TaskFadeText Grid.Column="3" Style="{StaticResource CompareValue}" Value="{Binding Value}" TextAlignment="Right" />
                    </Grid>
                </tasks:TaskAutomationBlock>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <tasks:TaskSideHeader DataContext="{Binding Single}" HorizontalAlignment="Left" Margin="0,0,0,14"
                              HistogramWidth="{Binding DataContext.HistogramWidth, RelativeSource={RelativeSource AncestorType=tasks:TaskSingleView}}"
                              Visibility="{Binding DataContext.IsNarrow, RelativeSource={RelativeSource AncestorType=tasks:TaskSingleView}, Converter={StaticResource Hidden}}" />
        <tasks:TaskSideCard DataContext="{Binding Single}" Margin="0,0,0,12"
                            Visibility="{Binding DataContext.IsNarrow, RelativeSource={RelativeSource AncestorType=tasks:TaskSingleView}, Converter={StaticResource Visible}}" />
        <Rectangle Style="{DynamicResource Hairline}" Margin="0,0,0,6" />
        <ItemsControl ItemsSource="{Binding SingleRows}" ItemTemplate="{StaticResource SingleRowTemplate}" Focusable="False" />
    </StackPanel>
</UserControl>
