<Window x:Class="AgentSpeed.Radar.RadarWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AgentSpeed.Localization"
        Title="{loc:Loc win.radar.windowTitle}" Width="1220" Height="860" MinWidth="740" MinHeight="500"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" UseLayoutRounding="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="RadarStyles.xaml" /></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="24,20,24,16">
        <StackPanel DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc win.radar.windowTitle}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc win.radar.subtitle}" Margin="0,4,12,0" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Loc win.radar.source}" Click="OnSource" Padding="12,6" Margin="0,0,8,0" />
                    <Button x:Name="RefreshButton" Content="{loc:Loc win.radar.refresh}" Click="OnRefresh" Padding="12,6" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="StatusText" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Separator Margin="0,14,0,12" />
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12,9" CornerRadius="6"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock x:Name="SelectionText" TextWrapping="Wrap" FontSize="12" />
        </Border>
        <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{loc:Loc win.radar.recommendations}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc win.radar.recommendationNote}" Margin="0,3,0,10" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <UniformGrid x:Name="RecommendationsGrid" Columns="3" Margin="0,0,-6,0" />
                <Grid Margin="0,18,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc win.radar.scores}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="CountText" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <TextBlock Text="{loc:Loc win.radar.scoreNote}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ScrollViewer x:Name="MatrixScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnMatrixMouseWheel">
                    <Grid x:Name="ScoreGrid" MinWidth="1100" />
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Text="{loc:Loc win.radar.emptyScores}" TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock x:Name="SourceDateText" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Expander Header="{loc:Loc win.radar.rules}" Margin="0,14,0,0">
                    <TextBlock Text="{loc:Loc win.radar.ruleDetail}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
